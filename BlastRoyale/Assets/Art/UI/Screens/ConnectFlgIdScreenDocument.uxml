<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Art/UI/Screens/ConnectFlgIdScreenStyle.uss?fileID=7433441132597879392&amp;guid=62c1d9d88fd9646f987a3c9d8d48a713&amp;type=3#ConnectFlgIdScreenStyle" />
    <Style src="project://database/Assets/Art/UI/Styles/GenericDialogStyle.uss?fileID=7433441132597879392&amp;guid=d1862850e9c3aaa4aa77ed63ff317bf3&amp;type=3#GenericDialogStyle" />
    <Style src="project://database/Assets/Art/UI/Styles/PopupElementStyle.uss?fileID=7433441132597879392&amp;guid=374b9cc1f935a80428e43e051f7a4fd9&amp;type=3#PopupElementStyle" />
    <ui:VisualElement name="root" class="background" style="justify-content: center; align-items: center; width: 100%; height: 100%;">
        <FirstLight.Game.UIElements.ImageButton name="CloseButton" class="button-close" />
        <FirstLight.Game.UIElements.PopupElement name="Popup" title-localization-key="UITAccount/link_title" class="popup--large" style="width: 1000px; height: auto;">
            <FirstLight.Game.UIElements.LocalizedLabel name="Desc" localization-key="UITAccount/description" class="font-style-popup content__desc" />
            <ui:VisualElement class="height-spacer height-spacer--xxl" />
            <ui:VisualElement class="content__controls" style="flex-direction: column; align-items: center;">
                <FirstLight.Game.UIElements.LocalizedButton name="LinkAccountButton" localization-key="UITAccount/link_current_guest" class="button-long button-long--yellow" />
                <FirstLight.Game.UIElements.LocalizedButton name="LoginButton" localization-key="UITAccount/sign_in" class="button-long" />
            </ui:VisualElement>
            <ui:VisualElement class="height-spacer height-spacer--m" />
        </FirstLight.Game.UIElements.PopupElement>
    </ui:VisualElement>
</ui:UXML>
