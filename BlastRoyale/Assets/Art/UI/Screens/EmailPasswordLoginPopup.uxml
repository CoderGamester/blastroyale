<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Art/UI/Styles/EmailPasswordLoginPopup.uss?fileID=7433441132597879392&amp;guid=d03d70e82e2e61a4f90819ef45058ad5&amp;type=3#EmailPasswordLoginPopup" />
    <ui:VisualElement name="root" class="background" style="justify-content: center; align-items: center; width: 100%; height: 100%;">

        <FirstLight.Game.UIElements.GenericPopupElement name="Popup" title-localization-key="UITAccount/login_title" class="popup--large" style="width: 1000px; height: auto;">
            <FirstLight.Game.UIElements.LocalizedLabel name="Desc" localization-key="UITAccount/description" class="font-style-popup content__desc" />
            <ui:VisualElement class="height-spacer height-spacer--xxl" />
            <ui:VisualElement class="content__controls" style="flex-direction: column; align-items: center;">
                <FirstLight.Game.UIElements.LocalizedButton name="ContinueGuestButton" localization-key="UITAccount/continue_guest" class="button-long" />
                <FirstLight.Game.UIElements.LocalizedButton name="LoginButton" localization-key="UITAccount/sign_in" class="button-long button-long--yellow" />
            </ui:VisualElement>
            <ui:VisualElement class="height-spacer height-spacer--m" />
        </FirstLight.Game.UIElements.GenericPopupElement>
    </ui:VisualElement>
</ui:UXML>
