
.currency-shine {
    flex-grow: 1;
    background-image: url("project://database/Assets/Art/Textures/Particles/Chest_Opening_Vfx_256_Star.png?fileID=2800000&guid=9b3a580ab61ae6d4899b963367de2c83&type=3#Chest_Opening_Vfx_256_Star");
    -unity-background-image-tint-color: rgb(0, 240, 253);
    position: absolute;
    width: 221px;
    height: 218px;
    top: -66px;
    left: -79px;
    rotate: 431deg;
    transition-duration: 0s;
    transition-timing-function: ease;
}

.currency-display__icon-outline {
    width: 75px;
    height: 75px;
    margin-left: -25px;
    align-items: center;
    justify-content: center;
    -unity-background-image-tint-color: black;
}

.currency-display__icon {
    width: 95%;
    height: 95%;
    position: absolute;
}

.currency-display__label {
    -unity-text-align: middle-center;
    height: 52px;
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 6px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 4px 6px black;
    position: absolute;
    left: 47px;
    white-space: nowrap;
    min-width: 132px;
}

.currency-display__plussign {
    width: 150px;
}

.currency-display__label__plussign {
    font-size: 65px;
    top: -5px;
    left: 25px;
    align-self: center;
}
